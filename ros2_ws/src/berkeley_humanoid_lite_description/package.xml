<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>berkeley_humanoid_lite_description</name>
  <version>0.1.0</version>
  <description>URDF and meshes for the Berkeley Humanoid Lite, packaged for ROS 2.</description>
  <maintainer email="hexk0131@gmail.com">hexk0131</maintainer>
  <!-- MIT for this package's own files. The DexHand meshes it installs
       (meshes_dexhand_left, meshes_v1) are CC BY-NC-SA 4.0; see THIRD_PARTY.md. -->
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
